# Synthetic credentials for a disposable local database only. Never use in production.
DATABASE_URL=postgresql+psycopg://mentora:local-test-only@127.0.0.1:55432/mentora_s0_test
DB_CONNECT_TIMEOUT_SECONDS=3
DB_STATEMENT_TIMEOUT_MS=3000
# Optional until identity integration is configured. Set BOTH in your private .env.
# Use an isolated Supabase project with email confirmation enabled and RS256/ES256 keys.
# SUPABASE_URL=https://your-project.supabase.co
# SUPABASE_PUBLISHABLE_KEY=sb_publishable_your-project-key
# SUPABASE_JWT_AUDIENCE=authenticated
# AUTH_HTTP_TIMEOUT_SECONDS=3

# Optional UUID; membership is unavailable until explicitly configured and provisioned.
# PILOT_INSTITUTION_ID=<operator-selected-pilot-uuid>
